# Explicit local demo. External services are not required.
DEMO_MODE=true
DATABASE_PATH=./data/milestoneguard.sqlite
UPLOAD_DIR=./data/uploads
APP_ORIGIN=http://localhost:3000
# npm run setup generates private random values in .env.local.
SESSION_SECRET=replace-with-a-random-32-byte-secret
JOBS_TOKEN=replace-with-a-different-random-32-byte-secret

# Optional paid LLM. Leave blank for the complete rule-based demo.
# Choose an available provider/model ID from https://ai-gateway.vercel.sh/v1/models.
# Project scope and submission metadata are sent to the provider only when enabled.
AI_GATEWAY_API_KEY=
AI_MODEL=

# Optional direct OpenAI instead of AI Gateway. Both values are required; no default paid model.
OPENAI_API_KEY=
OPENAI_MODEL=
# Text excerpts are sent only when this flag AND the uploader's explicit checkbox are enabled.
AI_ALLOW_EVIDENCE_TEXT=false

# Optional independent Testnet mode. No mainnet configuration is supported.
# Use a SEPARATE database/upload directory for blockchain development.
STELLAR_TESTNET_ENABLED=false
STELLAR_ESCROW_CONTRACT_ID=
